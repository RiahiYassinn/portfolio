# Place your character in public/, then set its path here.
# The guide defaults to this asset when no path is configured.
VITE_RIVE_GUIDE_SRC=/testr.riv
VITE_RIVE_GUIDE_STATE_MACHINE=State Machine 1

# Keep provider keys server-side. Never prefix these with VITE_.
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_key
ELEVENLABS_MODEL=eleven_flash_v2_5
